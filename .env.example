# Copy to .env and replace every value. Never commit .env.
POSTGRES_PASSWORD=change-me-postgres
MINIO_ROOT_USER=quantumforge
MINIO_ROOT_PASSWORD=change-me-minio-secret
# Shared secret between the API and the development worker (>= 16 characters).
QF_DEV_WORKER_TOKEN=change-me-worker-token

# Development conveniences. Both must be false in any shared environment.
QF_DEV_LOGIN=true
QF_ALLOW_DEV_ISOLATION=true

# OIDC (optional locally, required in production).
QF_OIDC_ISSUER=
QF_OIDC_AUDIENCE=
